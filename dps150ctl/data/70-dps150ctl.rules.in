# Generated by dps150ctl: persistent access for UID @UID@ to USB serial @SERIAL@.
# Reapply the ACL on reconnect, retaining the normal owner/group and other ACLs.
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="5740", ATTRS{serial}=="@SERIAL@", RUN+="/usr/bin/setfacl -m u:@UID@:rw $env{DEVNAME}"
